# Environment Configuration Template
# Copy this file to .env.local and fill in the values for your environment
# DO NOT commit this file with real credentials

# Test Environment Selection
TEST_ENV=local

# Application Base URL
BASE_URL=http://localhost:3000

# Azure Configuration (only needed if USE_MOCKS=false)
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_CONTAINER=uploads
AZURE_ML_WORKSPACE=your-ml-workspace
AZURE_REGISTRY_ENDPOINT=https://your-workspace.ml.azure.com
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group

# Authentication Configuration
AUTH_METHOD=mock
AUTH_ENDPOINT=https://login.microsoftonline.com/your-tenant
AUTH_CLIENT_ID=your-client-id

# Test Behavior
USE_MOCKS=true
HEADLESS=true
TIMEOUT=30000
PARALLEL_WORKERS=1

# CI/CD Configuration
CI=false

# Debug Options
DEBUG=false
TRACE_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# Azure Credentials (CI/CD only - use GitHub Secrets)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# Performance Tuning
BROWSER_TIMEOUT=30000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000